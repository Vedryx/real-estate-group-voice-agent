# Copy to .env and fill in real values. Never commit .env.
# See README.md for where each credential comes from.

# --- LiveKit server (Cloud or self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam AI (STT: saaras:v3, TTS: bulbul:v3) ---
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

GOOGLE_API_KEY=your-google-api-key

# --- LLM (reasoning / tool-calling brain, §3.2) ---
# No separate key needed by default: agent/worker.py uses LiveKit Cloud's
# inference gateway (livekit.agents.inference.LLM), which authenticates
# with LIVEKIT_API_KEY/LIVEKIT_API_SECRET above and is billed to the
# LiveKit project. Override the model via LLM_MODEL (default
# "deepseek-ai/deepseek-v3"); see inference.LLMModels for other options
# (OpenAI/Google/Moonshot/DeepSeek/zAI/xAI - no Anthropic models exposed
# through this gateway as of writing).
# LLM_MODEL=deepseek-ai/deepseek-v3

# --- Voice pipeline: ONE knob, three modes ---
# VOICE_MODE picks the whole pipeline. Change this single line per call:
#   cascade -> Sarvam STT + LLM_MODEL (text) + Sarvam TTS   (cheapest, ~2.9s, native Hindi)
#   gemini  -> Gemini Live speech-to-speech                 (fast on 3.1-live; premium)
#   openai  -> OpenAI Realtime speech-to-speech             (PAID; Hindi voice weaker)
# S2S_MODEL / S2S_VOICE below are applied to whichever s2s provider is active
# (a wrong-family model id or voice is ignored and falls back to the default).
# VOICE_MODE=cascade
#
# gemini mode: GOOGLE_API_KEY (AI Studio, free tier). Fast model:
# S2S_MODEL=gemini-3.1-flash-live-preview   # blank -> native-audio-preview-12-2025 (LAGGY)
# S2S_VOICE=Puck                            # Puck/Charon/Kore/Fenrir/Aoede
#
# openai mode: OPENAI_API_KEY (PAID, billing + Realtime access; no free tier).
# S2S_MODEL=gpt-realtime-mini               # blank -> gpt-realtime-mini
# S2S_VOICE=marin                           # marin/cedar/alloy/echo/shimmer/ash/ballad/coral/sage/verse
#
# (Legacy: VOICE_MODE=s2s + S2S_PROVIDER=gemini|openai still works.)

# --- Telnyx (telephony, replaces plan.md §3.1's Twilio - see telephony/README.md) ---
# https://portal.telnyx.com/#/app/api-keys - only needed if scripting the
# Telnyx-side FQDN connection/number setup via their API; the portal
# click-through path in telephony/README.md doesn't need this at all.
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# --- Agent worker ---
# Explicit dispatch agent name (must match telephony/dispatch-rule.json), §3.1 step 6
AGENT_NAME=The Real Estate Group

# Which vertical to run: "canopy" (default, outbound real-estate sales),
# "clinic" (inbound clinic-appointment receptionist, Wellness Point Clinic
# demo), "salon" (inbound salon-appointment receptionist, Aura Salon & Spa
# demo), or "garage" (inbound auto-garage receptionist - car service + car
# rental, Prime Auto Garage & Rentals demo). Each is a self-contained
# persona/knowledge/tools set - see agent/worker.py's VERTICAL branch. Use
# scripts/run-canopy-agent.sh / scripts/run-clinic-agent.sh /
# scripts/run-salon-agent.sh / scripts/run-garage-agent.sh to run any of them
# (or several at once, under different AGENT_NAMEs) without editing this file.
# VERTICAL=canopy
